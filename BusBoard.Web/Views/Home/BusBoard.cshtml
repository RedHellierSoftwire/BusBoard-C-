@using BusBoard.Controllers
@using BusBoard.Models
@using BusBoard.Web.Models
@model BusBoardViewModel
@{
    ViewData["Title"] = "Busboard";
}

<div>
    <h1>Bus Board</h1>
</div>

<div>
    @using (Html.BeginForm("BusBoard","Home", FormMethod.Get)) 
    {
        <fieldset>
            <legend>Find the next busses near you</legend>
            <div>
                <label for="postcode">Enter you postcode:</label>
                @Html.TextBoxFor(m => m.Postcode)
            </div>
            <div>
                <button type="submit">Submit</button>
            </div>
        </fieldset>
    }

    @if (Model != null)
    {
        @if (Model.BusBoardEntries?.Count > 0) {
            <p>Bus Arrival Information Found for Stops Near @Model.Postcode</p>
            @foreach (BusBoardEntry entry in Model.BusBoardEntries) {
                <p>Stop @entry.StopLetter - @entry.CommonName</p>
                @foreach (BusArrivalPrediction arrival in entry.Arrivals) {
                    <p>@BusArrivalsController.GetBusArrivalDisplayInformation(arrival)</p>
                }
            }
        } else if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
            <p>@Model.ErrorMessage</p>
        }
    }
</div>